APP_ENCRYPTION_KEY= # 64 hex chars — generate: openssl rand -hex 32
DATABASE_URL=file:./prisma/dev.db
DOCX_SERVICE_URL=http://localhost:8001
PORT=3001
# Demo lokal: cp .env.example .env && openssl rand -hex 32 → isi APP_ENCRYPTION_KEY, lalu bunx prisma generate && bunx prisma db push && bun run db:seed
# Jika "Unable to open database file", ganti DATABASE_URL ke absolute: file:/absolute/path/prisma/dev.db

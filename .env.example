APP_ENCRYPTION_KEY= # 64 hex chars — generate: openssl rand -hex 32
DATABASE_URL=file:./prisma/dev.db
DOCX_SERVICE_URL=http://localhost:8001
PORT=3001
# Demo lokal: cp .env.example .env && openssl rand -hex 32 → isi APP_ENCRYPTION_KEY, lalu bunx prisma generate && bunx prisma db push && bun run db:seed
# Jika "Unable to open database file", ganti DATABASE_URL ke absolute: file:/absolute/path/prisma/dev.db

# Panel admin
# Origin yang diizinkan memanggil API (sesi admin memakai cookie, jadi wildcard tidak dipakai)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Set true HANYA bila di belakang reverse proxy; kalau tidak, X-Forwarded-For bisa dipalsukan
TRUST_PROXY=false
# Akun admin awal — dibaca saat `bun run db:seed`. Wajib ganti password saat login pertama.
SEED_ADMIN_NIDN=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
# Kosongkan untuk super admin; isi slug fakultas (mis. fikom) untuk admin fakultas
SEED_ADMIN_FACULTY=

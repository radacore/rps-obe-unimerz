{
  "name": "rps-obe-generator",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run server.ts & vite --port 3000",
    "dev:api": "bun run server.ts",
    "dev:web": "vite --port 3000",
    "theme:build": "bunx astryx theme build src/lib/theme.ts",
    "build": "bun run theme:build && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:generate": "bunx prisma generate",
    "db:migrate": "bunx prisma migrate dev",
    "db:push": "bunx prisma db push",
    "db:seed": "bunx prisma db seed",
    "docx:install": "pip install -r docx_service/requirements.txt",
    "docx:dev": "uvicorn docx_service.app:app --host 0.0.0.0 --port 8001 --reload",
    "dev:all": "bun run server.ts & python3 -m uvicorn docx_service.app:app --host 127.0.0.1 --port 8001 --reload & vite --port 3000",
    "preview:api": "bun run server.ts",
    "docx:test": "python3 -m pytest docx_service/test_generate.py -q"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.5.4",
    "@astryxdesign/theme-neutral": "^0.5.4",
    "@prisma/client": "^5.22.0",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.120.0",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.168.37",
    "docx": "^9.7.1",
    "docx-preview": "^0.4.0",
    "hono": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.5.4",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  }
}